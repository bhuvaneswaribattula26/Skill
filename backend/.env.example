# Environment Variables — copy to .env and fill in values

# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────
# Runtime URL. For Supabase, the transaction-pooler URL (port 6543) is fine.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skillswap?schema=public"
# Required only for Prisma schema changes. In Supabase: Connect → Direct connection.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_very_long_access_secret_here
JWT_REFRESH_SECRET=your_very_long_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ───────────────────────────────────────────────
# Leave blank to use in-memory fallback for local dev
REDIS_URL=redis://localhost:6379

# ─── Email — Resend (resend.com) ─────────────────────────
# Leave blank to use console fallback in dev
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@skillswapcampus.com

# ─── Cloudinary ──────────────────────────────────────────
# Leave blank to use dicebear avatar URLs as fallback
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── AI Matching ─────────────────────────────────────────
# One of these is enough; Gemini is preferred
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# How many top matches should get AI-generated explanations (costs API calls)
AI_MATCH_EXPLAIN_TOP_N=5

# ─── Learning resources ─────────────────────────────────
# Create a restricted key in Google Cloud with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ─── Email Domain Allow-list ─────────────────────────────
# Comma-separated glob patterns. Students must register with matching emails.
ALLOWED_EMAIL_DOMAINS=*.edu,*.edu.in,*.ac.in,*.ac.uk

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Frontend URL (for email links) ──────────────────────
FRONTEND_URL=http://localhost:4000
